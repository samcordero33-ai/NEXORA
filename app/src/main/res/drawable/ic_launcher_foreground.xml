<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono de NEXORA: una "N" Angular construida con trazos gruesos en verde neón,
  sobre la paleta gaming oscura. Se dibuja dentro de la zona segura del icono
  adaptativo (66 dp centrales de los 108 dp del lienzo).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="9" android:translateY="9">

        <!-- Marco exterior: acento secundario violeta -->
        <path
            android:fillColor="#00000000"
            android:pathData="M45,12 L74,32 L74,58 L45,78 L16,58 L16,32 Z"
            android:strokeColor="#FF7C5CFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3" />

        <!-- Letra N: palo izquierdo, diagonal y palo derecho en verde neón -->
        <path
            android:pathData="M33,58 L33,32"
            android:strokeColor="#FF00E676"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
        <path
            android:pathData="M33,32 L57,58"
            android:strokeColor="#FF00E676"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
        <path
            android:pathData="M57,58 L57,32"
            android:strokeColor="#FF00E676"
            android:strokeLineCap="round"
            android:strokeWidth="7" />
    </group>
</vector>
