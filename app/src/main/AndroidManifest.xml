<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permisos de almacenamiento.

      NEXORA necesita leer ejecutables que el usuario ha puesto en su
      dispositivo. Hay dos vías y se declaran las dos:

      1. READ_EXTERNAL_STORAGE (hasta API 32). En Android 12L y anteriores es
         el permiso clásico de lectura del almacenamiento compartido. Se pide
         en tiempo de ejecución. A partir de API 33 el sistema lo ignora: de
         ahi el maxSdkVersion.

      2. MANAGE_EXTERNAL_STORAGE (desde API 30). Es la unica forma de recorrer
         por ruta el almacenamiento compartido y la microSD bajo Scoped
         Storage, que es justo lo que hace la busqueda automatica de juegos.
         No se pide con un dialogo de runtime: se solicita llevando al usuario
         al ajuste del sistema (StorageAccessController.allFilesAccessIntent).
         Se marca tools:ignore="ScopedStorage" porque su uso es intencional y
         no un descuido de migracion.

      La via principal de la aplicacion sigue siendo el Storage Access
      Framework ("Escanear carpeta"), que no necesita ningun permiso.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Fase 9: HUD flotante de rendimiento.

      SYSTEM_ALERT_WINDOW es el permiso "Aparecer encima de otras apps". No se
      concede con un dialogo de runtime: el usuario tiene que activarlo en
      Ajustes, y por eso la app comprueba Settings.canDrawOverlays antes de
      intentar dibujar nada.

      El servicio va en primer plano porque la ventana debe seguir viva
      cuando el usuario cambia al juego. En Android 14 el tipo es obligatorio:
      specialUse es el que corresponde a una superposicion de diagnostico.
      POST_NOTIFICATIONS solo afecta a que se vea la notificacion del
      servicio; sin ella el HUD sigue funcionando.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NexoraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nexora">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Fase 9: servicio del HUD flotante. exported=false porque solo lo
          arranca la propia app; foregroundServiceType specialUse porque
          dibuja una superposición de diagnóstico mientras corre un juego.
        -->
        <service
            android:name=".runtime.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="HUD flotante de metricas durante la ejecucion de un juego" />
        </service>

        <!--
          Fase 7: FileProvider para compartir logs de diagnóstico como .txt.
          La autoridad debe coincidir con la usada por DiagnosticsViewModel.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nexora_file_paths" />
        </provider>
    </application>

</manifest>
